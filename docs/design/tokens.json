{
  "$description": "Fusion-style enterprise design tokens. W3C DTCG format. Layers: primitive -> semantic -> component. Components must only reference semantic tokens, never primitives directly. Brand ramp steps 100/300/700/800/900/950 are the six hexes from the palette reference; every other step is derived.",

  "primitive": {
    "color": {
      "$type": "color",
      "white": { "$value": "#FFFFFF" },
      "green": {
        "50":  { "$value": "#F0F8F2", "$description": "derived" },
        "100": { "$value": "#DAF1DE", "$description": "given" },
        "200": { "$value": "#BADBC3", "$description": "derived" },
        "300": { "$value": "#8EB69B", "$description": "given" },
        "400": { "$value": "#6C9D7D", "$description": "derived" },
        "500": { "$value": "#4A8264", "$description": "derived" },
        "600": { "$value": "#2E6455", "$description": "derived" },
        "700": { "$value": "#235347", "$description": "given" },
        "800": { "$value": "#163832", "$description": "given" },
        "900": { "$value": "#0B2B26", "$description": "given" },
        "950": { "$value": "#051F20", "$description": "given" }
      },
      "neutral": {
        "50":  { "$value": "#F4F6F4" },
        "100": { "$value": "#ECEFEC" },
        "200": { "$value": "#DEE3DF" },
        "300": { "$value": "#C7CFC9" },
        "400": { "$value": "#9AA59E" },
        "500": { "$value": "#6F7C74" },
        "600": { "$value": "#56625A" },
        "700": { "$value": "#404A44" },
        "800": { "$value": "#2A322D" },
        "900": { "$value": "#171D1A" },
        "950": { "$value": "#0C100E" }
      },
      "mint": {
        "50":  { "$value": "#E6F5EC" },
        "300": { "$value": "#7CCB9B" },
        "600": { "$value": "#1F8A4C" },
        "700": { "$value": "#1B6B3C" },
        "900": { "$value": "#0E3B21" }
      },
      "red": {
        "50":  { "$value": "#FEECEA" },
        "100": { "$value": "#FBD5D1" },
        "300": { "$value": "#F5A39B" },
        "600": { "$value": "#D92D20" },
        "700": { "$value": "#B42318" },
        "800": { "$value": "#8E1B12" },
        "900": { "$value": "#4A1410" }
      },
      "amber": {
        "50":  { "$value": "#FFF4DB" },
        "300": { "$value": "#F2C25C" },
        "600": { "$value": "#C98200" },
        "800": { "$value": "#7A4B00" },
        "900": { "$value": "#3F2800" }
      },
      "blue": {
        "50":  { "$value": "#E8F1FB" },
        "300": { "$value": "#94BDEB" },
        "600": { "$value": "#2A6FBF" },
        "700": { "$value": "#1D5FA8" },
        "900": { "$value": "#0F2F55" }
      }
    },
    "space": {
      "$type": "dimension",
      "0":  { "$value": "0px" },
      "1":  { "$value": "4px" },
      "2":  { "$value": "8px" },
      "3":  { "$value": "12px" },
      "4":  { "$value": "16px" },
      "5":  { "$value": "20px" },
      "6":  { "$value": "24px" },
      "8":  { "$value": "32px" },
      "10": { "$value": "40px" },
      "12": { "$value": "48px" },
      "16": { "$value": "64px" }
    },
    "radius": {
      "$type": "dimension",
      "none": { "$value": "0px" },
      "sm":   { "$value": "8px" },
      "md":   { "$value": "12px" },
      "lg":   { "$value": "16px" },
      "xl":   { "$value": "24px" },
      "2xl":  { "$value": "32px" },
      "full": { "$value": "9999px" }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": "'IBM Plex Sans Thai', 'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif", "$description": "Includes Thai and Latin glyphs in one family so mixed text keeps one rhythm." },
        "mono": { "$value": "'IBM Plex Mono', ui-monospace, 'SF Mono', Consolas, monospace" }
      },
      "size": {
        "$type": "dimension",
        "xs":  { "$value": "0.75rem" },
        "sm":  { "$value": "0.875rem" },
        "md":  { "$value": "1rem" },
        "lg":  { "$value": "1.125rem" },
        "xl":  { "$value": "1.25rem" },
        "2xl": { "$value": "1.5rem" },
        "3xl": { "$value": "1.875rem" },
        "4xl": { "$value": "2.5rem" },
        "5xl": { "$value": "3rem" }
      },
      "weight": {
        "$type": "fontWeight",
        "light":    { "$value": 300 },
        "regular":  { "$value": 400 },
        "medium":   { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold":     { "$value": 700 }
      },
      "line": {
        "$type": "number",
        "tight":   { "$value": 1.3, "$description": "Floor for Thai: below ~1.3 tone marks and vowels clip." },
        "snug":    { "$value": 1.4 },
        "normal":  { "$value": 1.5 },
        "relaxed": { "$value": 1.7 }
      },
      "numeric": {
        "tabular": { "$value": "tabular-nums", "$type": "other" }
      }
    },
    "shadow": {
      "$type": "shadow",
      "sm": { "$value": "0 1px 2px rgb(12 16 14 / 0.06)" },
      "md": { "$value": "0 4px 12px rgb(12 16 14 / 0.08)" },
      "lg": { "$value": "0 12px 32px rgb(12 16 14 / 0.14)" }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "1": { "$value": "1px" },
        "2": { "$value": "2px" }
      },
      "style": {
        "solid":  { "$value": "solid",  "$type": "other" },
        "dashed": { "$value": "dashed", "$type": "other" }
      }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" },
      "pulse": { "$value": "1600ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": [0.2, 0, 0, 1] },
      "decelerate": { "$value": [0, 0, 0, 1] },
      "accelerate": { "$value": [0.3, 0, 1, 1] }
    },
    "breakpoint": {
      "$type": "dimension",
      "$description": "Literal values. CSS custom properties cannot be used inside @media; read these from JSON/JS.",
      "sm":  { "$value": "640px" },
      "md":  { "$value": "768px" },
      "lg":  { "$value": "1024px" },
      "xl":  { "$value": "1280px" },
      "2xl": { "$value": "1536px" }
    }
  },

  "semantic": {
    "shared": {
      "space": {
        "$type": "dimension",
        "inset": {
          "control-x": { "$value": "{primitive.space.4}" },
          "card":      { "$value": "{primitive.space.6}" },
          "dialog":    { "$value": "{primitive.space.6}" },
          "cell-x":    { "$value": "{primitive.space.4}" }
        },
        "gap": {
          "inline":  { "$value": "{primitive.space.2}" },
          "stack":   { "$value": "{primitive.space.4}" },
          "section": { "$value": "{primitive.space.6}" }
        }
      },
      "radius": {
        "$type": "dimension",
        "control": { "$value": "{primitive.radius.full}", "$description": "Buttons, chips, nav pills, badges." },
        "field":   { "$value": "{primitive.radius.lg}",   "$description": "Input, select, textarea." },
        "choice":  { "$value": "{primitive.radius.sm}",   "$description": "Checkbox. Radio is always full." },
        "card":    { "$value": "{primitive.radius.xl}" },
        "inner":   { "$value": "{primitive.radius.lg}",   "$description": "Panel nested inside a card." },
        "dialog":  { "$value": "{primitive.radius.xl}" },
        "menu":    { "$value": "{primitive.radius.lg}" },
        "tooltip": { "$value": "{primitive.radius.sm}" },
        "skeleton": { "$value": "{primitive.radius.sm}" }
      },
      "size": {
        "$type": "dimension",
        "control": {
          "sm": { "$value": "32px" },
          "md": { "$value": "40px" },
          "lg": { "$value": "48px" }
        },
        "icon": {
          "sm": { "$value": "16px" },
          "md": { "$value": "20px" },
          "lg": { "$value": "24px" }
        },
        "choice":  { "$value": "20px" },
        "row":     { "$value": "56px", "$description": "Table row height." },
        "sidebar": { "$value": "72px" },
        "content-max": { "$value": "1440px" },
        "dialog": {
          "sm": { "$value": "400px" },
          "md": { "$value": "560px" },
          "lg": { "$value": "720px" }
        },
        "menu-min": { "$value": "192px" },
        "avatar": {
          "sm": { "$value": "32px" },
          "md": { "$value": "40px" }
        }
      },
      "icon": {
        "stroke": { "$value": 1.75, "$type": "number", "$description": "One stroke width for every Lucide icon." }
      },
      "border": {
        "width": { "$value": "{primitive.border.width.1}", "$type": "dimension" },
        "width-focus": { "$value": "{primitive.border.width.2}", "$type": "dimension" }
      },
      "shadow": {
        "$type": "shadow",
        "card":    { "$value": "{primitive.shadow.sm}" },
        "popover": { "$value": "{primitive.shadow.md}" },
        "dialog":  { "$value": "{primitive.shadow.lg}" }
      },
      "focus": {
        "offset": { "$value": "2px", "$type": "dimension" }
      },
      "z": {
        "$type": "number",
        "base":     { "$value": 0 },
        "raised":   { "$value": 10 },
        "dropdown": { "$value": 1000 },
        "sticky":   { "$value": 1100 },
        "overlay":  { "$value": 1200 },
        "modal":    { "$value": 1300 },
        "popover":  { "$value": 1400 },
        "toast":    { "$value": 1500 },
        "tooltip":  { "$value": 1600 }
      },
      "type": {
        "kpi":     { "size": { "$value": "{primitive.font.size.4xl}" }, "weight": { "$value": "{primitive.font.weight.light}" },    "line": { "$value": "{primitive.font.line.tight}" } },
        "h1":      { "size": { "$value": "{primitive.font.size.3xl}" }, "weight": { "$value": "{primitive.font.weight.semibold}" }, "line": { "$value": "{primitive.font.line.snug}" } },
        "h2":      { "size": { "$value": "{primitive.font.size.2xl}" }, "weight": { "$value": "{primitive.font.weight.semibold}" }, "line": { "$value": "{primitive.font.line.snug}" } },
        "h3":      { "size": { "$value": "{primitive.font.size.xl}" },  "weight": { "$value": "{primitive.font.weight.semibold}" }, "line": { "$value": "{primitive.font.line.snug}" } },
        "title":   { "size": { "$value": "{primitive.font.size.lg}" },  "weight": { "$value": "{primitive.font.weight.medium}" },   "line": { "$value": "{primitive.font.line.snug}" } },
        "body":    { "size": { "$value": "{primitive.font.size.md}" },  "weight": { "$value": "{primitive.font.weight.regular}" },  "line": { "$value": "{primitive.font.line.normal}" } },
        "body-sm": { "size": { "$value": "{primitive.font.size.sm}" },  "weight": { "$value": "{primitive.font.weight.regular}" },  "line": { "$value": "{primitive.font.line.normal}" } },
        "label":   { "size": { "$value": "{primitive.font.size.sm}" },  "weight": { "$value": "{primitive.font.weight.medium}" },   "line": { "$value": "{primitive.font.line.normal}" } },
        "caption": { "size": { "$value": "{primitive.font.size.xs}" },  "weight": { "$value": "{primitive.font.weight.regular}" },  "line": { "$value": "{primitive.font.line.normal}" } }
      },
      "motion": {
        "duration": { "$value": "{primitive.duration.base}", "$type": "duration" },
        "easing":   { "$value": "{primitive.easing.standard}", "$type": "cubicBezier" }
      }
    },

    "compact": {
      "$description": "Applied with [data-density=\"compact\"]. Overrides sizes and insets only.",
      "size": {
        "$type": "dimension",
        "control": { "sm": { "$value": "28px" }, "md": { "$value": "32px" }, "lg": { "$value": "40px" } },
        "row": { "$value": "40px" }
      },
      "space": {
        "$type": "dimension",
        "inset": { "card": { "$value": "{primitive.space.4}" }, "cell-x": { "$value": "{primitive.space.3}" } },
        "gap": { "section": { "$value": "{primitive.space.4}" } }
      }
    },

    "touch": {
      "$description": "Applied under @media (pointer: coarse). Raises targets to 44px.",
      "size": {
        "$type": "dimension",
        "control": { "sm": { "$value": "44px" }, "md": { "$value": "44px" }, "lg": { "$value": "48px" } },
        "row": { "$value": "56px" }
      }
    },

    "light": {
      "color": {
        "$type": "color",
        "surface": {
          "canvas":   { "$value": "{primitive.color.neutral.50}" },
          "card":     { "$value": "{primitive.color.white}" },
          "raised":   { "$value": "{primitive.color.white}" },
          "sunken":   { "$value": "{primitive.color.neutral.100}" },
          "hover":    { "$value": "{primitive.color.neutral.100}" },
          "selected": { "$value": "{primitive.color.green.50}" },
          "inverse":  { "$value": "{primitive.color.green.900}" },
          "scrim":    { "$value": "rgb(5 31 32 / 0.48)" }
        },
        "text": {
          "primary":   { "$value": "{primitive.color.green.950}" },
          "secondary": { "$value": "{primitive.color.neutral.700}" },
          "muted":     { "$value": "{primitive.color.neutral.600}" },
          "inverse":   { "$value": "{primitive.color.white}" },
          "brand":     { "$value": "{primitive.color.green.700}" },
          "disabled":  { "$value": "{primitive.color.neutral.500}" }
        },
        "border": {
          "subtle":        { "$value": "{primitive.color.neutral.200}" },
          "default":       { "$value": "{primitive.color.green.200}", "$description": "Decorative green line (cards, dividers). Not a control boundary." },
          "accent":        { "$value": "{primitive.color.green.700}" },
          "control":       { "$value": "{primitive.color.neutral.500}", "$description": "Input/select/checkbox/radio boundary. Must be >= 3:1." },
          "control-hover": { "$value": "{primitive.color.green.700}" },
          "error":         { "$value": "{primitive.color.red.600}" }
        },
        "focus": {
          "ring": { "$value": "{primitive.color.green.600}" }
        },
        "action": {
          "primary": {
            "bg":        { "$value": "{primitive.color.green.700}" },
            "bg-hover":  { "$value": "{primitive.color.green.800}" },
            "bg-active": { "$value": "{primitive.color.green.900}" },
            "text":      { "$value": "{primitive.color.white}" }
          },
          "secondary": {
            "bg":        { "$value": "{primitive.color.white}" },
            "bg-hover":  { "$value": "{primitive.color.green.50}" },
            "bg-active": { "$value": "{primitive.color.green.100}" },
            "text":      { "$value": "{primitive.color.green.700}" },
            "border":    { "$value": "{primitive.color.green.700}" }
          },
          "ghost": {
            "bg":        { "$value": "transparent" },
            "bg-hover":  { "$value": "{primitive.color.neutral.100}" },
            "bg-active": { "$value": "{primitive.color.neutral.200}" },
            "text":      { "$value": "{primitive.color.green.950}" }
          },
          "danger": {
            "bg":        { "$value": "{primitive.color.red.700}" },
            "bg-hover":  { "$value": "{primitive.color.red.800}" },
            "bg-active": { "$value": "{primitive.color.red.900}" },
            "text":      { "$value": "{primitive.color.white}" }
          },
          "disabled": {
            "bg":   { "$value": "{primitive.color.neutral.100}" },
            "text": { "$value": "{primitive.color.neutral.500}" }
          }
        },
        "nav": {
          "active-bg":   { "$value": "{primitive.color.green.900}" },
          "active-text": { "$value": "{primitive.color.white}" },
          "item-text":   { "$value": "{primitive.color.neutral.700}" },
          "item-hover":  { "$value": "{primitive.color.neutral.100}" }
        },
        "status": {
          "success": { "bg": { "$value": "{primitive.color.mint.50}" },  "text": { "$value": "{primitive.color.mint.700}" }, "border": { "$value": "{primitive.color.mint.300}" } },
          "danger":  { "bg": { "$value": "{primitive.color.red.50}" },   "text": { "$value": "{primitive.color.red.700}" },  "border": { "$value": "{primitive.color.red.300}" } },
          "warning": { "bg": { "$value": "{primitive.color.amber.50}" }, "text": { "$value": "{primitive.color.amber.800}" }, "border": { "$value": "{primitive.color.amber.300}" } },
          "info":    { "bg": { "$value": "{primitive.color.blue.50}" },  "text": { "$value": "{primitive.color.blue.700}" }, "border": { "$value": "{primitive.color.blue.300}" } },
          "neutral": { "bg": { "$value": "{primitive.color.neutral.100}" }, "text": { "$value": "{primitive.color.neutral.700}" }, "border": { "$value": "{primitive.color.neutral.300}" } }
        },
        "chart": {
          "series-1": { "$value": "{primitive.color.green.700}" },
          "series-2": { "$value": "{primitive.color.green.400}" },
          "series-3": { "$value": "{primitive.color.amber.600}" },
          "series-4": { "$value": "{primitive.color.blue.600}" },
          "series-5": { "$value": "{primitive.color.neutral.500}" },
          "grid":      { "$value": "{primitive.color.neutral.200}" },
          "bar-muted": { "$value": "{primitive.color.green.100}", "$description": "Solid tint for non-highlighted bars. No hatch gradients." },
          "bar-highlight": { "$value": "{primitive.color.green.800}" }
        },
        "skeleton": {
          "bg":        { "$value": "{primitive.color.neutral.100}" },
          "bg-strong": { "$value": "{primitive.color.neutral.200}" }
        },
        "tooltip": {
          "bg":   { "$value": "{primitive.color.green.900}" },
          "text": { "$value": "{primitive.color.white}" }
        }
      }
    },

    "dark": {
      "color": {
        "$type": "color",
        "surface": {
          "canvas":   { "$value": "{primitive.color.neutral.950}" },
          "card":     { "$value": "{primitive.color.neutral.900}" },
          "raised":   { "$value": "{primitive.color.neutral.800}" },
          "sunken":   { "$value": "{primitive.color.neutral.950}" },
          "hover":    { "$value": "{primitive.color.neutral.800}" },
          "selected": { "$value": "{primitive.color.green.900}" },
          "inverse":  { "$value": "{primitive.color.green.100}" },
          "scrim":    { "$value": "rgb(0 0 0 / 0.64)" }
        },
        "text": {
          "primary":   { "$value": "{primitive.color.neutral.50}" },
          "secondary": { "$value": "{primitive.color.neutral.300}" },
          "muted":     { "$value": "{primitive.color.neutral.400}" },
          "inverse":   { "$value": "{primitive.color.green.950}" },
          "brand":     { "$value": "{primitive.color.green.300}" },
          "disabled":  { "$value": "{primitive.color.neutral.500}" }
        },
        "border": {
          "subtle":        { "$value": "{primitive.color.neutral.800}" },
          "default":       { "$value": "{primitive.color.green.800}" },
          "accent":        { "$value": "{primitive.color.green.300}" },
          "control":       { "$value": "{primitive.color.neutral.500}" },
          "control-hover": { "$value": "{primitive.color.green.300}" },
          "error":         { "$value": "{primitive.color.red.300}" }
        },
        "focus": {
          "ring": { "$value": "{primitive.color.green.300}" }
        },
        "action": {
          "primary": {
            "bg":        { "$value": "{primitive.color.green.300}" },
            "bg-hover":  { "$value": "{primitive.color.green.200}" },
            "bg-active": { "$value": "{primitive.color.green.100}" },
            "text":      { "$value": "{primitive.color.green.950}" }
          },
          "secondary": {
            "bg":        { "$value": "{primitive.color.neutral.900}" },
            "bg-hover":  { "$value": "{primitive.color.green.900}" },
            "bg-active": { "$value": "{primitive.color.green.800}" },
            "text":      { "$value": "{primitive.color.green.300}" },
            "border":    { "$value": "{primitive.color.green.300}" }
          },
          "ghost": {
            "bg":        { "$value": "transparent" },
            "bg-hover":  { "$value": "{primitive.color.neutral.800}" },
            "bg-active": { "$value": "{primitive.color.neutral.700}" },
            "text":      { "$value": "{primitive.color.neutral.50}" }
          },
          "danger": {
            "bg":        { "$value": "{primitive.color.red.300}" },
            "bg-hover":  { "$value": "{primitive.color.red.100}" },
            "bg-active": { "$value": "{primitive.color.red.50}" },
            "text":      { "$value": "{primitive.color.red.900}" }
          },
          "disabled": {
            "bg":   { "$value": "{primitive.color.neutral.800}" },
            "text": { "$value": "{primitive.color.neutral.500}" }
          }
        },
        "nav": {
          "active-bg":   { "$value": "{primitive.color.green.300}" },
          "active-text": { "$value": "{primitive.color.green.950}" },
          "item-text":   { "$value": "{primitive.color.neutral.300}" },
          "item-hover":  { "$value": "{primitive.color.neutral.800}" }
        },
        "status": {
          "success": { "bg": { "$value": "{primitive.color.mint.900}" },  "text": { "$value": "{primitive.color.mint.300}" }, "border": { "$value": "{primitive.color.mint.700}" } },
          "danger":  { "bg": { "$value": "{primitive.color.red.900}" },   "text": { "$value": "{primitive.color.red.300}" },  "border": { "$value": "{primitive.color.red.700}" } },
          "warning": { "bg": { "$value": "{primitive.color.amber.900}" }, "text": { "$value": "{primitive.color.amber.300}" }, "border": { "$value": "{primitive.color.amber.800}" } },
          "info":    { "bg": { "$value": "{primitive.color.blue.900}" },  "text": { "$value": "{primitive.color.blue.300}" }, "border": { "$value": "{primitive.color.blue.700}" } },
          "neutral": { "bg": { "$value": "{primitive.color.neutral.800}" }, "text": { "$value": "{primitive.color.neutral.300}" }, "border": { "$value": "{primitive.color.neutral.700}" } }
        },
        "chart": {
          "series-1": { "$value": "{primitive.color.green.300}" },
          "series-2": { "$value": "{primitive.color.green.500}" },
          "series-3": { "$value": "{primitive.color.amber.300}" },
          "series-4": { "$value": "{primitive.color.blue.300}" },
          "series-5": { "$value": "{primitive.color.neutral.400}" },
          "grid":      { "$value": "{primitive.color.neutral.800}" },
          "bar-muted": { "$value": "{primitive.color.green.800}" },
          "bar-highlight": { "$value": "{primitive.color.green.300}" }
        },
        "skeleton": {
          "bg":        { "$value": "{primitive.color.neutral.800}" },
          "bg-strong": { "$value": "{primitive.color.neutral.700}" }
        },
        "tooltip": {
          "bg":   { "$value": "{primitive.color.green.100}" },
          "text": { "$value": "{primitive.color.green.950}" }
        }
      }
    }
  },

  "component": {
    "button": {
      "$description": "Variants (primary/secondary/ghost/danger) take colors from semantic color.action.*. States: default, hover, focus-visible, active, disabled, loading (spinner icon, width locked, aria-busy).",
      "radius":    { "$value": "{semantic.shared.radius.control}", "$type": "dimension" },
      "height-sm": { "$value": "{semantic.shared.size.control.sm}", "$type": "dimension" },
      "height-md": { "$value": "{semantic.shared.size.control.md}", "$type": "dimension" },
      "height-lg": { "$value": "{semantic.shared.size.control.lg}", "$type": "dimension" },
      "padding-x": { "$value": "{semantic.shared.space.inset.control-x}", "$type": "dimension" },
      "gap":       { "$value": "{semantic.shared.space.gap.inline}", "$type": "dimension" },
      "icon-only-size": { "$value": "{semantic.shared.size.control.md}", "$type": "dimension" },
      "font-size":   { "$value": "{semantic.shared.type.label.size}", "$type": "dimension" },
      "font-weight": { "$value": "{semantic.shared.type.label.weight}", "$type": "fontWeight" }
    },
    "field": {
      "$description": "Input, Select, Textarea. States: default, hover, focus, disabled, error (border + icon + message), loading (inline spinner).",
      "radius":    { "$value": "{semantic.shared.radius.field}", "$type": "dimension" },
      "height":    { "$value": "{semantic.shared.size.control.md}", "$type": "dimension" },
      "padding-x": { "$value": "{semantic.shared.space.inset.control-x}", "$type": "dimension" },
      "border-width": { "$value": "{semantic.shared.border.width}", "$type": "dimension" },
      "bg":          { "$value": "{semantic.light.color.surface.card}", "$type": "color" },
      "placeholder": { "$value": "{semantic.light.color.text.muted}", "$type": "color" }
    },
    "choice": {
      "$description": "Checkbox and Radio. Checked fill = action.primary.bg. Indeterminate for checkbox only.",
      "size":            { "$value": "{semantic.shared.size.choice}", "$type": "dimension" },
      "radius-checkbox": { "$value": "{semantic.shared.radius.choice}", "$type": "dimension" },
      "radius-radio":    { "$value": "{primitive.radius.full}", "$type": "dimension" }
    },
    "card": {
      "bg":      { "$value": "{semantic.light.color.surface.card}", "$type": "color" },
      "border":  { "$value": "{semantic.light.color.border.default}", "$type": "color" },
      "radius":  { "$value": "{semantic.shared.radius.card}", "$type": "dimension" },
      "padding": { "$value": "{semantic.shared.space.inset.card}", "$type": "dimension" },
      "shadow":  { "$value": "{semantic.shared.shadow.card}", "$type": "shadow" },
      "gap":     { "$value": "{semantic.shared.space.gap.stack}", "$type": "dimension" }
    },
    "dialog": {
      "radius":  { "$value": "{semantic.shared.radius.dialog}", "$type": "dimension" },
      "padding": { "$value": "{semantic.shared.space.inset.dialog}", "$type": "dimension" },
      "shadow":  { "$value": "{semantic.shared.shadow.dialog}", "$type": "shadow" },
      "width-sm": { "$value": "{semantic.shared.size.dialog.sm}", "$type": "dimension" },
      "width-md": { "$value": "{semantic.shared.size.dialog.md}", "$type": "dimension" },
      "width-lg": { "$value": "{semantic.shared.size.dialog.lg}", "$type": "dimension" },
      "z":       { "$value": "{semantic.shared.z.modal}", "$type": "number" },
      "z-overlay": { "$value": "{semantic.shared.z.overlay}", "$type": "number" }
    },
    "menu": {
      "$description": "Dropdown, select list, popover menu. Item states: default, hover, focus, selected, disabled.",
      "radius":    { "$value": "{semantic.shared.radius.menu}", "$type": "dimension" },
      "shadow":    { "$value": "{semantic.shared.shadow.popover}", "$type": "shadow" },
      "min-width": { "$value": "{semantic.shared.size.menu-min}", "$type": "dimension" },
      "item-height": { "$value": "{semantic.shared.size.control.md}", "$type": "dimension" },
      "z":         { "$value": "{semantic.shared.z.dropdown}", "$type": "number" }
    },
    "nav": {
      "$description": "Top pill navigation and the icon sidebar. Active item = filled pill (nav.active-bg), never color alone: also aria-current=page.",
      "item-radius": { "$value": "{semantic.shared.radius.control}", "$type": "dimension" },
      "item-height": { "$value": "{semantic.shared.size.control.md}", "$type": "dimension" },
      "item-padding-x": { "$value": "{semantic.shared.space.inset.control-x}", "$type": "dimension" },
      "sidebar-width": { "$value": "{semantic.shared.size.sidebar}", "$type": "dimension" },
      "z": { "$value": "{semantic.shared.z.sticky}", "$type": "number" }
    },
    "table": {
      "row-height": { "$value": "{semantic.shared.size.row}", "$type": "dimension" },
      "cell-padding-x": { "$value": "{semantic.shared.space.inset.cell-x}", "$type": "dimension" },
      "header-bg":  { "$value": "{semantic.light.color.surface.sunken}", "$type": "color" },
      "row-hover":  { "$value": "{semantic.light.color.surface.hover}", "$type": "color" },
      "row-selected": { "$value": "{semantic.light.color.surface.selected}", "$type": "color" },
      "divider":    { "$value": "{semantic.light.color.border.subtle}", "$type": "color" }
    },
    "badge": {
      "$description": "Variants success/danger/warning/info/neutral from semantic color.status.*. Always icon + text (never color alone).",
      "radius":    { "$value": "{semantic.shared.radius.control}", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.space.2}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.space.1}", "$type": "dimension" },
      "font-size": { "$value": "{semantic.shared.type.caption.size}", "$type": "dimension" },
      "font-weight": { "$value": "{semantic.shared.type.label.weight}", "$type": "fontWeight" }
    },
    "tooltip": {
      "radius":  { "$value": "{semantic.shared.radius.tooltip}", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.space.3}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.space.2}", "$type": "dimension" },
      "z":       { "$value": "{semantic.shared.z.tooltip}", "$type": "number" }
    },
    "feedback": {
      "$description": "Alert (inline, persistent), Toast (transient, role=status; errors role=alert), Inline field message. Colors from semantic color.status.*.",
      "radius":  { "$value": "{semantic.shared.radius.inner}", "$type": "dimension" },
      "padding": { "$value": "{primitive.space.4}", "$type": "dimension" },
      "gap":     { "$value": "{semantic.shared.space.gap.inline}", "$type": "dimension" },
      "toast-z": { "$value": "{semantic.shared.z.toast}", "$type": "number" }
    },
    "skeleton": {
      "$description": "Opacity pulse only. No shimmer gradient.",
      "radius":   { "$value": "{semantic.shared.radius.skeleton}", "$type": "dimension" },
      "duration": { "$value": "{primitive.duration.pulse}", "$type": "duration" }
    },
    "state": {
      "$description": "Empty / Error / Success blocks inside cards and pages.",
      "icon-size": { "$value": "{semantic.shared.size.icon.lg}", "$type": "dimension" },
      "gap":       { "$value": "{semantic.shared.space.gap.stack}", "$type": "dimension" },
      "padding":   { "$value": "{primitive.space.10}", "$type": "dimension" }
    }
  }
}
